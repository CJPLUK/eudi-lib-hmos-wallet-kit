// ===========================================================================
// TransactionStatus
// ===========================================================================
@Test
class WkSupportTransactionStatusUT {

    @TestCase
    func rawValues(): Unit {
        @Expect(TransactionStatus.Completed.rawValue(), "completed")
        @Expect(TransactionStatus.Failed.rawValue(), "failed")
        @Expect(TransactionStatus.Cancelled.rawValue(), "cancelled")
    }

    @TestCase
    func fromRawKnown(): Unit {
        match (TransactionStatus.fromRaw("failed")) {
            case Some(s) => @Expect(s.rawValue(), "failed")
            case None => @Expect("none", "some")
        }
    }

    @TestCase
    func fromRawUnknownIsNone(): Unit {
        @Expect(TransactionStatus.fromRaw("bogus").isNone(), true)
    }
}

// ===========================================================================
// TransactionLog in-memory store
// ===========================================================================
@Test
class WkSupportTransactionLogStoreUT {

    @TestCase
    func emptyLogState(): Unit {
        let log = TransactionLog()
        @Expect(log.count(), 0)
        @Expect(log.allEntries().size, 0)
        @Expect(log.lastEntry().isNone(), true)
    }

    @TestCase
    func appendIncrementsCountAndLast(): Unit {
        let log = TransactionLog()
        let e1 = TransactionLogEntry("id-1", TransactionType.Issuance, "2026-01-01T00:00:00Z", TransactionStatus.Completed)
        let e2 = TransactionLogEntry("id-2", TransactionType.Deletion, "2026-01-02T00:00:00Z", TransactionStatus.Failed)
        log.append(e1)
        log.append(e2)
        @Expect(log.count(), 2)
        @Expect(log.allEntries().size, 2)
        match (log.lastEntry()) {
            case Some(e) => @Expect(e.id, "id-2")
            case None => @Expect("none", "some")
        }
    }

    @TestCase
    func clearEmptiesLog(): Unit {
        let log = TransactionLog()
        log.append(TransactionLogEntry("x", TransactionType.Signing, "t", TransactionStatus.Completed))
        log.clear()
        @Expect(log.count(), 0)
        @Expect(log.lastEntry().isNone(), true)
    }
}

// ===========================================================================
// TransactionLogUtils
// ===========================================================================
@Test
class WkSupportTransactionLogUtilsUT {

    @TestCase
    func initializeCreatesCompletedEntry(): Unit {
        let e = TransactionLogUtils.initializeTransactionLog("uuid-1", TransactionType.Issuance)
        @Expect(e.id, "uuid-1")
        @Expect(e.status.rawValue(), "completed")
        @Expect(e.timestamp.size > 0, true)
        @Expect(e.errorMessage.isNone(), true)
    }

    @TestCase
    func setErrorMarksFailed(): Unit {
        let e = TransactionLogUtils.initializeTransactionLog("uuid-2", TransactionType.Signing)
        TransactionLogUtils.setErrorTransactionLog(e, "boom")
        @Expect(e.status.rawValue(), "failed")
        match (e.errorMessage) {
            case Some(m) => @Expect(m, "boom")
            case None => @Expect("none", "some")
        }
    }

    @TestCase
    func presentationRequestThenResponseInfo(): Unit {
        let e = TransactionLogUtils.initializeTransactionLog("p1", TransactionType.PresentationOpenId4Vp)
        let requested: Array<String> = ["family_name", "birth_date"]
        TransactionLogUtils.setPresentationRequestInfo(e, "org.iso.18013.5.1.mDL", Some("verifier-1"), requested, Some("nonce-x"))
        @Expect(e.presentationData.isSome(), true)
        @Expect(TransactionLogUtils.getRelyingParty(e).isSome(), true)
        match (TransactionLogUtils.getRelyingParty(e)) {
            case Some(rp) => @Expect(rp, "verifier-1")
            case None => @Expect("none", "some")
        }
        // Now overwrite with disclosed claims, preserving docType/relyingParty/nonce
        let disclosed: Array<String> = ["family_name"]
        TransactionLogUtils.setPresentationResponseInfo(e, disclosed)
        match (e.presentationData) {
            case Some(pd) =>
                @Expect(pd.docType, "org.iso.18013.5.1.mDL")
                @Expect(pd.disclosedClaims.size, 1)
                @Expect(pd.disclosedClaims[0], "family_name")
                match (pd.requestNonce) {
                    case Some(n) => @Expect(n, "nonce-x")
                    case None => @Expect("none", "some")
                }
            case None => @Expect("none", "some")
        }
    }

    @TestCase
    func getRelyingPartyNoneForNonPresentation(): Unit {
        let e = TransactionLogUtils.initializeTransactionLog("d1", TransactionType.Deletion)
        @Expect(TransactionLogUtils.getRelyingParty(e).isNone(), true)
    }

    @TestCase
    func issuanceInfoAttached(): Unit {
        let e = TransactionLogUtils.initializeTransactionLog("i1", TransactionType.Issuance)
        TransactionLogUtils.setIssuanceInfo(e, "org.iso.18013.5.1.mDL", Some("https://issuer"), true)
        match (e.issuanceData) {
            case Some(d) =>
                @Expect(d.docType, "org.iso.18013.5.1.mDL")
                @Expect(d.isDeferred, true)
            case None => @Expect("none", "some")
        }
    }

    @TestCase
    func deletionInfoAttached(): Unit {
        let e = TransactionLogUtils.initializeTransactionLog("del1", TransactionType.Deletion)
        TransactionLogUtils.setDeletionInfo(e, "org.iso.18013.5.1.mDL", "doc-99")
        match (e.deletionData) {
            case Some(d) =>
                @Expect(d.docType, "org.iso.18013.5.1.mDL")
                @Expect(d.documentId, "doc-99")
            case None => @Expect("none", "some")
        }
    }

    @TestCase
    func signingInfoAttached(): Unit {
        let e = TransactionLogUtils.initializeTransactionLog("s1", TransactionType.Signing)
        TransactionLogUtils.setSigningInfo(e, "ES256", Some("cs-1"))
        match (e.signingData) {
            case Some(d) => @Expect(d.algorithm, "ES256")
            case None => @Expect("none", "some")
        }
    }
}

