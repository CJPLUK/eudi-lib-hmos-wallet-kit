@Test
class WkSupportLogDataCarriersUT {

    @TestCase
    func presentationLogData(): Unit {
        let claims: Array<String> = ["a", "b"]
        let d = PresentationLogData("t", Some("rp"), claims, None)
        @Expect(d.docType, "t")
        @Expect(d.disclosedClaims.size, 2)
        @Expect(d.requestNonce.isNone(), true)
    }

    @TestCase
    func issuanceLogData(): Unit {
        let d = IssuanceLogData("t", None, false)
        @Expect(d.isDeferred, false)
        @Expect(d.issuerUrl.isNone(), true)
    }

    @TestCase
    func deletionLogData(): Unit {
        let d = DeletionLogData("t", "id-1")
        @Expect(d.documentId, "id-1")
    }

    @TestCase
    func signingLogData(): Unit {
        let d = SigningLogData("ES384", Some("cs"))
        @Expect(d.algorithm, "ES384")
    }
}

// ===========================================================================
// LogLevel
// ===========================================================================
@Test
class WkSupportLogLevelUT {

    @TestCase
    func severityOrdering(): Unit {
        @Expect(LogLevel.Trace.severity(), 0)
        @Expect(LogLevel.Debug.severity(), 1)
        @Expect(LogLevel.Info.severity(), 2)
        @Expect(LogLevel.Notice.severity(), 3)
        @Expect(LogLevel.Warning.severity(), 4)
        @Expect(LogLevel.Error.severity(), 5)
        @Expect(LogLevel.Critical.severity(), 6)
        @Expect(LogLevel.Critical.severity() > LogLevel.Trace.severity(), true)
    }

    @TestCase
    func labels(): Unit {
        @Expect(LogLevel.Trace.label(), "TRACE")
        @Expect(LogLevel.Warning.label(), "WARN")
        @Expect(LogLevel.Critical.label(), "CRITICAL")
        @Expect(LogLevel.Notice.label(), "NOTICE")
    }
}

// ===========================================================================
// WalletLogHandler / WalletLogger / FileLogging
// ===========================================================================
@Test
class WkSupportWalletLoggerUT {

    @TestCase
    func handlerHoldsLevelAndDomain(): Unit {
        let h = WalletLogHandler(domain: "TestDomain", logLevel: LogLevel.Warning)
        @Expect(h.domain, "TestDomain")
        @Expect(h.logLevel.severity(), LogLevel.Warning.severity())
    }

    @TestCase
    func handlerBelowThresholdDoesNotThrow(): Unit {
        let h = WalletLogHandler(domain: "D", logLevel: LogLevel.Error)
        // Info < Error threshold -> silently discarded (must not throw)
        h.log(level: LogLevel.Info, message: "ignored", source: None)
        // Error >= threshold -> emitted (must not throw)
        h.log(level: LogLevel.Error, message: "shown", source: Some("src"))
        @Expect(true, true)
    }

    @TestCase
    func loggerSetLogLevelUpdatesProp(): Unit {
        let logger = WalletLogger(label: "L")
        @Expect(logger.logLevel.severity(), LogLevel.Info.severity())
        logger.setLogLevel(LogLevel.Error)
        @Expect(logger.logLevel.severity(), LogLevel.Error.severity())
    }

    @TestCase
    func loggerConvenienceMethodsDoNotThrow(): Unit {
        let logger = WalletLogger(label: "L2", level: LogLevel.Trace)
        logger.trace("t")
        logger.debug("d")
        logger.info("i")
        logger.notice("n")
        logger.warning("w")
        logger.error("e")
        logger.critical("c")
        logger.info("with-source", "subsys")
        @Expect(true, true)
    }

    @TestCase
    func fileLoggingFactoryDefaultLevel(): Unit {
        let logger = FileLogging.makeLogger("Fac")
        @Expect(logger.logLevel.severity(), LogLevel.Info.severity())
        let logger2 = FileLogging.makeLogger("Fac2", LogLevel.Debug)
        @Expect(logger2.logLevel.severity(), LogLevel.Debug.severity())
    }
}
